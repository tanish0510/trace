{
  "name": "trace",
  "version": "0.1.0",
  "description": "Local-first memory and observability layer for AI-assisted software engineering workflows",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "trc": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "trace": "node dist/cli/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [
    "trace",
    "claude",
    "ai",
    "memory",
    "observability",
    "engineering",
    "sessions"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
